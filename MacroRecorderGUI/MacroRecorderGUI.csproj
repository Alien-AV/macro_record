<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MacroRecorderGUI</RootNamespace>
    <ApplicationIcon>mouse.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="mouse.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Common\protobuf\csharp\Events.cs" Link="Generated\Events.cs" />
    <Compile Include="..\Common\StatusEnum.cs" Link="Common\StatusEnum.cs" />
  </ItemGroup>

  <PropertyGroup>
    <NativeOutputDirectory Condition="'$(SolutionDir)' != ''">$(SolutionDir)x64\$(Configuration)\</NativeOutputDirectory>
    <NativeOutputDirectory Condition="'$(NativeOutputDirectory)' == ''">$(MSBuildProjectDirectory)\..\x64\$(Configuration)\</NativeOutputDirectory>
  </PropertyGroup>

  <Target Name="CopyNativeRuntimeToBuildOutput" AfterTargets="Build" Condition="Exists('$(NativeOutputDirectory)RecordPlaybackDLL.dll')">
    <Copy SourceFiles="$(NativeOutputDirectory)RecordPlaybackDLL.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeRuntimeToPublishOutput" AfterTargets="Publish" Condition="Exists('$(NativeOutputDirectory)RecordPlaybackDLL.dll')">
    <Copy SourceFiles="$(NativeOutputDirectory)RecordPlaybackDLL.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWinUIResourcesToPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <WinUIPublishResource Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
      <WinUIPublishResource Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WinUIPublishResource)"
      DestinationFiles="@(WinUIPublishResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
