<Application
    x:Class="MacroRecorderGUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="SystemAccentColor">#285ED9</Color>
            <Color x:Key="SystemAccentColorLight1">#6694F5</Color>
            <Color x:Key="SystemAccentColorLight2">#8CAFFF</Color>
            <Color x:Key="SystemAccentColorLight3">#CBDCFF</Color>
            <Color x:Key="SystemAccentColorDark1">#285ED9</Color>
            <Color x:Key="SystemAccentColorDark2">#204CB0</Color>
            <Color x:Key="SystemAccentColorDark3">#183986</Color>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/DesignTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
