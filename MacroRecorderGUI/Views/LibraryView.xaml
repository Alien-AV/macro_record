<UserControl x:Class="MacroRecorderGUI.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="View_SizeChanged" ActualThemeChanged="View_ThemeChanged" KeyDown="Library_KeyDown">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="LibraryLayout" Padding="30,27" Spacing="23">
            <Grid ColumnSpacing="20" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="RecentHeading" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <TextBlock x:Name="LibraryHeading" Text="Your recordings" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource MacroInkBrush}"/>
                    <TextBlock x:Name="CountLabel" FontSize="12" Foreground="{ThemeResource MacroMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="SearchHost" Grid.Column="1" Width="220" BorderBrush="{ThemeResource MacroLineBrush}" BorderThickness="1" CornerRadius="6" Background="{ThemeResource MacroPaperBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource MacroMutedBrush}" Margin="11,0,0,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Find a recording" FontSize="12" BorderThickness="0" Background="Transparent"
                            TextChanging="Search_Changing" AutomationProperties.Name="Find a recording"/>
                    </Grid>
                </Border>
            </Grid>
            <StackPanel Spacing="10">
                <StackPanel x:Name="LibraryActions" Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="TrashToggle" Content="Local trash" Checked="Trash_Changed" Unchecked="Trash_Changed" AutomationProperties.Name="Show local recording trash"/>
                    <ToggleButton x:Name="CompactToggle" Content="Compact list" Checked="Compact_Changed" Unchecked="Compact_Changed" AutomationProperties.Name="Use compact recording list"/>
                    <Button x:Name="UndoDeleteButton" Content="Undo delete" Visibility="Collapsed" Click="UndoDelete_Click" AutomationProperties.Name="Restore the last deleted batch"/>
                </StackPanel>
                <TextBlock x:Name="TrashDescription" Text="Deleted recordings stay in local trash until you restore them, including after restarting. Imported and exported files are untouched."
                    Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource MacroMutedBrush}"/>
                <StackPanel x:Name="SelectionToolbar" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="SelectionCount" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource MacroInkBrush}"/>
                    <StackPanel x:Name="SelectionActions" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SelectAllButton" Content="Select all visible" Click="SelectAll_Click"/>
                        <Button x:Name="ClearSelectionButton" Content="Clear selection" Click="ClearSelection_Click"/>
                        <Button x:Name="BatchActionButton" Content="Delete selected" Click="BatchAction_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="SelectionScope" TextWrapping="Wrap" Foreground="{ThemeResource MacroMutedBrush}" FontSize="12"/>
                <TextBlock x:Name="OperationMessage" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource MacroInkBrush}"/>
            </StackPanel>
            <GridView x:Name="Cards" Margin="-10,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Cards_ItemClick"
                AutomationProperties.Name="Recordings" IsMultiSelectCheckBoxEnabled="False"
                HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="300"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="10,0,10,20"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="CornerRadius" Value="9"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="9" BorderBrush="{ThemeResource MacroLineBrush}" BorderThickness="1" Background="{ThemeResource MacroPaperBrush}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Visibility="{Binding ArtVisibility}" Height="{Binding ArtHeight}" Background="{ThemeResource MacroCardArtBrush}" CornerRadius="8,8,0,0">
                                    <Grid Margin="18,12" RowSpacing="6">
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Canvas x:Name="ThumbnailCanvas" Visibility="{Binding TraceVisibility}" Loaded="Thumbnail_Loaded" SizeChanged="Thumbnail_SizeChanged" IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding Thumbnail.InputSummary}" Visibility="{Binding InputVisibility}" FontSize="13" FontWeight="SemiBold"
                                            Foreground="{ThemeResource MacroInkBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Text="{Binding TraceLabel}" FontSize="11" Foreground="{ThemeResource MacroMutedBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Padding="{Binding BodyPadding}" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SelectionCheckBox" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top"
                                        AutomationProperties.Name="{Binding SelectLabel}" Checked="Selection_Changed" Unchecked="Selection_Changed"/>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="{Binding Name}" ToolTipService.ToolTip="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource MacroInkBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" ToolTipService.ToolTip="{Binding Summary}" FontSize="12" Foreground="{ThemeResource MacroMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="CardPlaybackSummary" Text="{Binding PlaybackSummary}" Visibility="{Binding PlaybackVisibility}"
                                            FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MacroInkBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding LastOpened}" FontSize="11" Foreground="{ThemeResource MacroMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="{Binding ActionsRow}" Grid.Column="{Binding ActionsColumn}" Grid.ColumnSpan="{Binding ActionsColumnSpan}"
                                    Padding="12,8,12,12" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="CardPlayButton" Content="Play" Style="{StaticResource MacroPrimaryButtonStyle}" Click="Play_Click" Padding="12,7"
                                        Visibility="{Binding PlaybackVisibility}" IsEnabled="{Binding PreferencesLoaded}" AutomationProperties.Name="{Binding PlayLabel}"/>
                                    <Button x:Name="CardPlaybackOptionsButton" Style="{StaticResource MacroIconButtonStyle}" Click="PlaybackOptions_Click"
                                        Visibility="{Binding PlaybackVisibility}" AutomationProperties.Name="{Binding PlaybackOptionsLabel}" ToolTipService.ToolTip="Playback options · saved for this recording">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                    </Button>
                                    <Button Content="Rename" FontSize="12" Style="{StaticResource MacroTextButtonStyle}" Padding="7,4" MinHeight="32"
                                        Visibility="{Binding RenameVisibility}" AutomationProperties.Name="{Binding RenameLabel}" Click="Rename_Click"/>
                                    <Button Style="{StaticResource MacroTextButtonStyle}" Padding="7" MinHeight="32" AutomationProperties.Name="{Binding OptionsLabel}" Click="CardOptions_Click">
                                        <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="EmptyState" Padding="25,30" HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Text="Your library starts here" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource MacroInkBrush}" TextAlignment="Center"/>
                <TextBlock x:Name="EmptyDescription" Text="Record a task or import an existing .macro file." FontSize="13" Foreground="{ThemeResource MacroMutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <Border x:Name="RecordingHint" Visibility="Collapsed" BorderBrush="{ThemeResource MacroLineBrush}" BorderThickness="0,1,0,0" Padding="0,28,0,0" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Background="{ThemeResource MacroKeyboardBrush}" CornerRadius="8" Width="33" Height="33">
                        <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{ThemeResource MacroKeyboardTextBrush}"/>
                    </Border>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Your next repetitive task, simplified." FontSize="12" Foreground="{ThemeResource MacroInkBrush}"/>
                        <TextBlock Text="Start recording with Ctrl + Q. Stop with Ctrl + W." FontSize="12" Foreground="{ThemeResource MacroMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
