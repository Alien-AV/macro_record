<UserControl
    x:Class="MacroRecorderGUI.Views.MacroTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Editor_Loaded" Unloaded="Editor_Unloaded" ActualThemeChanged="Editor_ThemeChanged">
    <Grid Padding="4,12" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="UndoButton" Grid.Column="1" Content="Undo" Click="Undo_Click" IsEnabled="False"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Undo the last editor change"/>
        </Grid>
        <ScrollViewer x:Name="WorkspaceScroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" SizeChanged="Workspace_SizeChanged">
            <Grid x:Name="Workspace" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="ListPanel">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Actions" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       ToolTipService.ToolTip="Use Ctrl or Shift to select several actions."/>
                            <Button Grid.Column="1" Content="Add" AutomationProperties.Name="Add raw event">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Add mouse event" Click="AddMouse_Click"/>
                                        <MenuFlyoutItem Text="Add keyboard event" Click="AddKeyboard_Click"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="Clear all actions" Click="Clear_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="DeleteButton" Grid.Column="2" Click="Delete_Click"
                                    AutomationProperties.Name="Delete selected actions" ToolTipService.ToolTip="Delete selected actions (Delete)">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SelectionScope" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ListView x:Name="ActionsList" Grid.Row="2" SelectionMode="Extended" SelectionChanged="Actions_SelectionChanged"
                                  KeyDown="Actions_KeyDown" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Recorded actions"
                                  AutomationProperties.HelpText="Use Ctrl or Shift to select multiple actions. Delete removes the selection.">
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Add mouse event" Click="AddMouse_Click"/>
                                    <MenuFlyoutItem Text="Add keyboard event" Click="AddKeyboard_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="Delete selection" Click="Delete_Click"/>
                                    <MenuFlyoutItem Text="Clear all actions" Click="Clear_Click"/>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="10" ToolTipService.ToolTip="{Binding TechnicalSummary}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Warning}" Visibility="{Binding WarningVisibility}" FontSize="12"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" ToolTipService.ToolTip="{Binding WarningExplanation}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Border x:Name="PathPanel" Grid.Column="1">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Path preview" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   ToolTipService.ToolTip="Selected path is accented. Start is an open circle; end is a diamond. Clicks use circles, drag starts use squares and drag paths use dashes. Paths are display-sampled; all original input is retained."/>
                        <TextBlock x:Name="PathNote" Grid.Row="1" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Canvas x:Name="PathCanvas" Background="Transparent" SizeChanged="Canvas_SizeChanged"
                                    PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved" PointerReleased="Canvas_PointerReleased"
                                    PointerCanceled="Canvas_PointerCanceled" PointerCaptureLost="Canvas_PointerCanceled"
                                    AutomationProperties.Name="Visual path; select actions or enter destination coordinates in the inspector"/>
                        </Border>
                        <Slider x:Name="Scrubber" Grid.Row="3" Minimum="0" Maximum="1000" StepFrequency="1"
                                ValueChanged="Scrub_Changed" AutomationProperties.Name="Visual preview position"/>
                        <Grid Grid.Row="4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="PreviewButton" Content="Preview" Click="Preview_Click" AutomationProperties.Name="Preview path, visual only"
                                    ToolTipService.ToolTip="Visual preview only. No input is sent."/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PreviewClock" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="Visual only · no input sent" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="InspectorPanel" Grid.Column="2" Padding="12,0,0,0"
                        BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" Padding="0,0,8,8">
                            <TextBlock x:Name="SelectedTitle" Text="Select an action" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="InspectorScope" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                            <TextBlock x:Name="ActionWarning" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed"/>
                            <ContentControl x:Name="ActionFields" IsEnabled="False" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Timing" FontWeight="SemiBold"
                                               ToolTipService.ToolTip="Delay precedes the action; duration is the time within it. Seconds accept up to 6 decimal places for exact microseconds. Apply each field separately."/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="WaitInput" Header="Delay (s)" MinWidth="0" ToolTipService.ToolTip="Seconds before this action. Up to 6 decimal places."/>
                                        <Button Grid.Column="1" Content="Apply" Click="Wait_Click" VerticalAlignment="Bottom" AutomationProperties.Name="Apply delay"/>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="DurationInput" Header="Duration (s)" MinWidth="0" ToolTipService.ToolTip="Time within this action. Preserves every event. Up to 6 decimal places."/>
                                        <Button x:Name="DurationButton" Grid.Column="1" Content="Apply" Click="Duration_Click" VerticalAlignment="Bottom" AutomationProperties.Name="Apply duration"/>
                                    </Grid>
                                    <TextBlock x:Name="GeometryNote" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ContentControl x:Name="DestinationFields" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBox x:Name="DestinationX" Header="X (px)" MinWidth="0" AutomationProperties.Name="Destination X in absolute pixels"/>
                                                <TextBox x:Name="DestinationY" Grid.Column="1" Header="Y (px)" MinWidth="0" AutomationProperties.Name="Destination Y in absolute pixels"/>
                                            </Grid>
                                            <Button Content="Apply position" Click="Destination_Click"
                                                    ToolTipService.ToolTip="Moves this endpoint and keeps the following movement connected."/>
                                        </StackPanel>
                                    </ContentControl>
                                </StackPanel>
                            </ContentControl>
                            <Expander x:Name="RawExpander" Header="Advanced" HorizontalAlignment="Stretch" Expanding="Raw_Expanding" Collapsed="Raw_Collapsed">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="TechnicalDetail" FontSize="12" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="ShowSamples" Content="Show path samples" Checked="Samples_Changed" Unchecked="Samples_Changed"/>
                                    <TextBlock Text="Original events · Ctrl/Shift to select several. Deleting now uses this raw selection." FontSize="12" TextWrapping="Wrap"/>
                                    <ListView x:Name="RawList" Height="180" SelectionMode="Extended" SelectionChanged="Raw_SelectionChanged" KeyDown="Actions_KeyDown" AutomationProperties.Name="Original events in the selected actions">
                                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"/></DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                    <TextBox x:Name="RawDelay" Header="This event's delay (µs)"/>
                                    <StackPanel x:Name="RawMouseFields" Spacing="6">
                                        <TextBox x:Name="RawX" Header="Raw X (pixels or device counts)"/>
                                        <TextBox x:Name="RawY" Header="Raw Y (pixels or device counts)"/>
                                        <TextBox x:Name="RawFlags" Header="Mouse flags (unsigned decimal)"/>
                                        <TextBox x:Name="RawData" Header="mouseData (unsigned decimal bits)"/>
                                        <CheckBox x:Name="RawRelative" Content="Relative device counts"/>
                                        <CheckBox x:Name="RawDesktop" Content="Virtual desktop mapping"/>
                                    </StackPanel>
                                    <StackPanel x:Name="RawKeyFields" Spacing="6">
                                        <TextBox x:Name="RawKey" Header="Virtual-key code (unsigned decimal)"/>
                                        <CheckBox x:Name="RawKeyUp" Content="Key up"/>
                                    </StackPanel>
                                    <Button x:Name="RawApply" Content="Apply this raw event" Click="RawApply_Click" IsEnabled="False"/>
                                    <TextBox x:Name="RawEachDelay" Header="Delay for EACH selected raw event (µs)" Text="5000"/>
                                    <Button Content="Set each selected raw delay" Click="RawEach_Click"/>
                                    <TextBlock Text="Bulk raw delay changes also change the action's duration." FontSize="12" TextWrapping="Wrap"/>
                                    <Expander Header="Convert path estimate" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Relative values are device counts, not pixels. Conversion assumes 1 count = 1 pixel after an existing absolute anchor; pointer speed/acceleration are unknown. Earlier unanchored input stays relative. This changes actual playback coordinates and is undoable." TextWrapping="Wrap" FontSize="12"/>
                                            <CheckBox x:Name="AcceptEstimate" Content="Use this explicit estimate"/>
                                            <Button Content="Convert anchored moves" Click="Convert_Click"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </ScrollViewer>
        <TextBlock x:Name="EditorStatus" Grid.Row="2" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</UserControl>
