<UserControl
    x:Class="MacroRecorderGUI.Views.MacroTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Editor_Loaded" Unloaded="Editor_Unloaded" SizeChanged="Editor_SizeChanged" ActualThemeChanged="Editor_ThemeChanged">
    <Grid Padding="4,10" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Action editor" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SelectionText" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="UndoButton" Grid.Column="1" Content="Undo edit" Click="Undo_Click" IsEnabled="False"/>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="Workspace" ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="ListPanel" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Actions · Ctrl/Shift to select several" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <ListView x:Name="ActionsList" Grid.Row="1" SelectionMode="Extended" SelectionChanged="Actions_SelectionChanged" KeyDown="Actions_KeyDown" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Recorded actions">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,5" Spacing="4">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Border x:Name="PathPanel" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Mouse path · move ─  drag ┄  click ○  drag start □" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="PathNote" Grid.Row="1" FontSize="12" TextWrapping="Wrap"/>
                        <Canvas x:Name="PathCanvas" Grid.Row="2" MinHeight="180" Background="{ThemeResource LayerFillColorDefaultBrush}" SizeChanged="Canvas_SizeChanged" PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved" PointerReleased="Canvas_PointerReleased" PointerCanceled="Canvas_PointerCanceled" PointerCaptureLost="Canvas_PointerCanceled" AutomationProperties.Name="Visual path; select actions or enter destination coordinates in the inspector"/>
                        <Slider x:Name="Scrubber" Grid.Row="3" Minimum="0" Maximum="1000" StepFrequency="1" ValueChanged="Scrub_Changed" AutomationProperties.Name="Visual preview position"/>
                        <StackPanel Grid.Row="4" Spacing="6">
                            <Button x:Name="PreviewButton" Content="Preview · visual only" Click="Preview_Click"/>
                            <TextBlock x:Name="PreviewClock" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="Preview moves only the dot. No input is sent. Paths are display-sampled; all raw input is retained." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>
                <Border x:Name="InspectorPanel" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Selected action" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="SelectedTitle" Text="Select an action to inspect" TextWrapping="Wrap"/>
                            <ContentControl x:Name="ActionFields" IsEnabled="False" HorizontalContentAlignment="Stretch">
                              <StackPanel Spacing="8">
                                <TextBox x:Name="WaitInput" Header="Wait before (seconds)"/>
                                <Button Content="Apply wait" Click="Wait_Click"/>
                                <TextBox x:Name="DurationInput" Header="Internal action duration (seconds)"/>
                                <Button x:Name="DurationButton" Content="Apply duration" Click="Duration_Click"/>
                                <TextBlock Text="Wait is separate. Duration retains every event. Use up to 6 decimal places for exact microseconds." FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="GeometryNote" FontSize="12" TextWrapping="Wrap"/>
                                <ContentControl x:Name="DestinationFields" HorizontalContentAlignment="Stretch">
                                  <StackPanel Spacing="8">
                                    <TextBox x:Name="DestinationX" Header="Destination X (absolute pixels)"/>
                                    <TextBox x:Name="DestinationY" Header="Destination Y (absolute pixels)"/>
                                    <Button Content="Apply destination" Click="Destination_Click"/>
                                  </StackPanel>
                                </ContentControl>
                                <CheckBox x:Name="ShowSamples" Content="Show selected samples" Checked="Samples_Changed" Unchecked="Samples_Changed"/>
                              </StackPanel>
                            </ContentControl>
                            <Expander x:Name="RawExpander" Header="Advanced · raw input" HorizontalAlignment="Stretch" Expanding="Raw_Expanding" Collapsed="Raw_Collapsed">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Each row is an original event. Raw edits can change grouping and input state." FontSize="12" TextWrapping="Wrap"/>
                                    <ListView x:Name="RawList" Height="180" SelectionMode="Extended" SelectionChanged="Raw_SelectionChanged" KeyDown="Actions_KeyDown" AutomationProperties.Name="Original events in the selected actions">
                                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"/></DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                    <TextBox x:Name="RawDelay" Header="This event's delay (µs)"/>
                                    <StackPanel x:Name="RawMouseFields" Spacing="6">
                                        <TextBox x:Name="RawX" Header="Raw X (pixels or device counts)"/>
                                        <TextBox x:Name="RawY" Header="Raw Y (pixels or device counts)"/>
                                        <TextBox x:Name="RawFlags" Header="Mouse flags (unsigned decimal)"/>
                                        <TextBox x:Name="RawData" Header="mouseData (unsigned decimal bits)"/>
                                        <CheckBox x:Name="RawRelative" Content="Relative device counts"/>
                                        <CheckBox x:Name="RawDesktop" Content="Virtual desktop mapping"/>
                                    </StackPanel>
                                    <StackPanel x:Name="RawKeyFields" Spacing="6">
                                        <TextBox x:Name="RawKey" Header="Virtual-key code (unsigned decimal)"/>
                                        <CheckBox x:Name="RawKeyUp" Content="Key up"/>
                                    </StackPanel>
                                    <Button x:Name="RawApply" Content="Apply this raw event" Click="RawApply_Click" IsEnabled="False"/>
                                    <TextBox x:Name="RawEachDelay" Header="Delay for EACH selected raw event (µs)" Text="5000"/>
                                    <Button Content="Set each selected raw delay" Click="RawEach_Click"/>
                                    <TextBlock Text="Bulk raw delay changes also change the action's duration." FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Convert an estimated path" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Relative values are device counts, not pixels. Conversion assumes 1 count = 1 pixel after an existing absolute anchor; pointer speed/acceleration are unknown. Earlier unanchored input stays relative. This changes actual playback coordinates and is undoable." TextWrapping="Wrap" FontSize="12"/>
                                    <CheckBox x:Name="AcceptEstimate" Content="Use this explicit estimate"/>
                                    <Button Content="Convert anchored moves" Click="Convert_Click"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </ScrollViewer>
        <TextBlock x:Name="EditorStatus" Grid.Row="2" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</UserControl>
