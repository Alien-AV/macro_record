<Window x:Class="MacroRecorderGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MacroRecorderGUI.Views" Title="Macro Recorder">
    <UserControl x:Name="FocusSurface" IsTabStop="False" KeyDown="Root_KeyDown">
    <Grid x:Name="RootGrid" Background="{ThemeResource MacroPaperBrush}"
        SizeChanged="Root_SizeChanged" ActualThemeChanged="Root_ThemeChanged" Loaded="Root_Loaded">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{ThemeResource MacroRailBrush}">
            <Grid Padding="9,24,9,14" RowSpacing="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Path Data="M7,27 L7,9 L18,20 L29,9 L29,27" Stroke="{ThemeResource MacroRailTextBrush}"
                    StrokeThickness="3" StrokeLineJoin="Round" Width="34" Height="34" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                <Button Grid.Row="1" Style="{StaticResource MacroRailButtonStyle}" Background="{ThemeResource MacroRailActiveBrush}"
                    Foreground="{ThemeResource MacroRailActiveTextBrush}" Click="Library_Click" AutomationProperties.Name="Recordings library">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE80A;" FontSize="21"/>
                        <TextBlock Text="Recordings" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeButton" Grid.Row="3" Style="{StaticResource MacroRailButtonStyle}" AutomationProperties.Name="Appearance">
                    <Button.Flyout><MenuFlyout>
                        <RadioMenuFlyoutItem x:Name="SystemThemeOption" Text="Use system theme" GroupName="Appearance" IsChecked="True" Tag="Default" Click="Theme_Click"/>
                        <RadioMenuFlyoutItem x:Name="LightThemeOption" Text="Light" GroupName="Appearance" Tag="Light" Click="Theme_Click"/>
                        <RadioMenuFlyoutItem x:Name="DarkThemeOption" Text="Dark" GroupName="Appearance" Tag="Dark" Click="Theme_Click"/>
                    </MenuFlyout></Button.Flyout>
                    <StackPanel Spacing="7"><FontIcon Glyph="&#xE706;" FontSize="21"/><TextBlock Text="Theme" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Grid.Row="4" Style="{StaticResource MacroRailButtonStyle}" Click="Settings_Click" AutomationProperties.Name="Settings and keyboard shortcuts">
                    <StackPanel Spacing="7"><FontIcon Glyph="&#xE9E9;" FontSize="21"/><TextBlock Text="Settings" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="{ThemeResource MacroLineBrush}" BorderThickness="0,0,0,1">
                <Grid x:Name="PageHeading" Padding="30,18,30,17" ColumnSpacing="20" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="9" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Button x:Name="BreadcrumbLibrary" Content="Recordings" Style="{StaticResource MacroTextButtonStyle}" Padding="0" MinHeight="0" Click="Library_Click"/>
                            <FontIcon x:Name="BreadcrumbChevron" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource MacroMutedBrush}"/>
                            <TextBlock x:Name="BreadcrumbName" FontSize="12" Foreground="{ThemeResource MacroMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <TextBlock x:Name="PageTitle" FontSize="25" FontWeight="SemiBold" CharacterSpacing="-28" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MacroInkBrush}"/>
                            <TextBlock x:Name="SaveState" FontSize="12" Foreground="{ThemeResource MacroGreenBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="HeadingActions" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Style="{StaticResource MacroIconButtonStyle}" Click="Undo_Click" AutomationProperties.Name="Undo change" ToolTipService.ToolTip="Undo change (Ctrl+Z)">
                            <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
                        </Button>
                        <Button x:Name="DocumentButton" Style="{StaticResource MacroIconButtonStyle}" AutomationProperties.Name="Recording commands" ToolTipService.ToolTip="Save, rename, export, and switch recordings">
                            <Button.Flyout><MenuFlyout x:Name="DocumentMenu" Opening="DocumentMenu_Opening"/></Button.Flyout>
                            <FontIcon Glyph="&#xE712;" FontSize="16"/>
                        </Button>
                        <Button x:Name="RecordButton" Style="{StaticResource MacroDarkButtonStyle}" Click="Record_Click" AutomationProperties.Name="Record a new task after the saved countdown, Ctrl+Q">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource MacroRedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Record"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RecordingOptionsButton" Style="{StaticResource MacroIconButtonStyle}" Click="RecordingOptions_Click"
                            AutomationProperties.Name="Recording options, does not start recording" ToolTipService.ToolTip="Recording options · saved for future recordings">
                            <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <views:LibraryView x:Name="Library" Visibility="Collapsed"/>
                <StackPanel x:Name="EmptyEditor" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Visibility="Collapsed" Margin="30">
                    <TextBlock Text="Your next repetitive task, simplified." FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource MacroInkBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Make a recording, import a .macro file, or reopen one from your library." FontSize="13" Foreground="{ThemeResource MacroMutedBrush}" TextWrapping="Wrap"/>
                    <Button Content="Open recordings" Click="Library_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{ThemeResource MacroLineBrush}" BorderThickness="0,1,0,0">
                <Grid x:Name="Transport" Padding="24,12" ColumnSpacing="18" RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid x:Name="TransportInfo" ColumnSpacing="22" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{ThemeResource MacroMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Stopped" FontSize="12" Foreground="{ThemeResource MacroInkBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                            <TextBlock x:Name="SummaryText" FontSize="11" Foreground="{ThemeResource MacroMutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel x:Name="PlaybackSettings" Grid.Column="1" Spacing="3" MaxWidth="240" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaybackSettingsSummary" Text="Loading playback options…" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="PlaybackSafetyNote" Text="Play sends real keyboard and mouse input" FontSize="11" Foreground="{ThemeResource MacroMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="TransportControls" Grid.Column="1" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BackToEditorButton" Content="←  Back to edit" Click="BackToEditor_Click" Visibility="Collapsed"/>
                        <Button x:Name="NextActionButton" Style="{StaticResource MacroIconButtonStyle}" Click="NextAction_Click" Visibility="Collapsed" AutomationProperties.Name="Next preview action">
                            <FontIcon Glyph="&#xE893;" FontSize="16"/>
                        </Button>
                        <Button x:Name="PreviewButton" Style="{StaticResource MacroPrimaryButtonStyle}" Click="Preview_Click" AutomationProperties.Name="Preview, original timing, no input sent to other apps" ToolTipService.ToolTip="Visual preview only · original captured timing · no input sent">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="PreviewIcon" Glyph="&#xE768;" FontSize="16"/><TextBlock x:Name="PreviewLabel" Text="Preview"/></StackPanel>
                        </Button>
                        <Button x:Name="PlayButton" Click="Play_Click" AutomationProperties.Name="Play in other apps, sends real input">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="13"/><TextBlock Text="Play"/></StackPanel>
                        </Button>
                        <Button x:Name="PlaybackOptionsButton" Style="{StaticResource MacroIconButtonStyle}" Click="PlaybackOptions_Click"
                            AutomationProperties.Name="Playback options for this recording, does not start playback" ToolTipService.ToolTip="Playback options · saved for this recording">
                            <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                        </Button>
                        <Button x:Name="StopButton" Content="Stop" Style="{StaticResource MacroStopButtonStyle}" Click="Stop_Click" Visibility="Collapsed"/>
                        <Button x:Name="ImportButton" Content="Import .macro" Click="Import_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="PreferenceWarning" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" FontSize="12"
                        Foreground="{ThemeResource MacroRedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </UserControl>
</Window>
