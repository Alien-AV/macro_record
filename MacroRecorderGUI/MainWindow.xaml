<Window
    x:Class="MacroRecorderGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Macro Recorder">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton Label="New macro" Click="AddTab_Click">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Add" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Load" Click="LoadEvents_Click">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="OpenFile" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Save" Click="SaveEvents_Click">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Save" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Record" Click="StartRecord_Click">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Play" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Stop recording" Click="StopRecord_Click">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Stop" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Playback" Click="PlayEvents_Click">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Play" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Abort playback" Click="AbortPlayback_Click">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Stop" />
                </AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Close application" Click="Close_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Cancel" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Border
            Grid.Row="1"
            Margin="12,4,12,8"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox
                        x:Name="ClearListOnStartRecord"
                        Content="Clear events when recording starts"
                        IsChecked="True"
                        VerticalAlignment="Center" />
                    <CheckBox
                        Content="Loop playback"
                        IsChecked="{Binding LoopPlayback, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button Content="Add mouse event" Click="CreateMouseEventManually_Click" />
                    <Button Content="Add keyboard event" Click="CreateKeyboardEventManually_Click" />
                    <Button Content="Remove selected" Click="RemoveEvent_Click" />
                    <Button Content="Clear all" Click="ClearList_Click" />
                    <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="Delay (µs)" VerticalAlignment="Center" />
                    <TextBox
                        x:Name="DelayTextBox"
                        Width="100"
                        BeforeTextChanging="UnsignedNumberTextBox_BeforeTextChanging"
                        Text="5000" />
                    <Button Content="Apply to selected" Click="ChangeDelays_Click" />
                    <CheckBox
                        x:Name="AutoChangeDelay"
                        Content="Apply after recording"
                        VerticalAlignment="Center" />
                    <Button
                        Content="Convert mouse positions to absolute"
                        Click="ConvertMouseEventsToAbsolutePositioning_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TabView
            x:Name="MacroTabs"
            Grid.Row="2"
            Margin="12,0,12,0"
            CanReorderTabs="True"
            CloseButtonOverlayMode="OnPointerOver"
            IsAddTabButtonVisible="True"
            TabWidthMode="SizeToContent"
            AddTabButtonClick="MacroTabs_AddTabButtonClick"
            SelectionChanged="MacroTabs_SelectionChanged"
            TabCloseRequested="MacroTabs_TabCloseRequested"
            TabDragCompleted="MacroTabs_TabDragCompleted" />

        <Grid Grid.Row="3" Padding="14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Ready" />
            <TextBlock
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Ctrl+Q Record · Ctrl+W Stop · Ctrl+E Play · Ctrl+R Abort" />
        </Grid>
    </Grid>
</Window>
