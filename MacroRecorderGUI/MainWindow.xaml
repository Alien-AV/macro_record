<Window
    x:Class="MacroRecorderGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macro Recorder">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          SizeChanged="Root_SizeChanged" ActualThemeChanged="Root_ThemeChanged" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PrimaryToolbar" Margin="12,8" Orientation="Horizontal" Spacing="6">
                <Button Click="StartRecord_Click" Padding="10,8" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Record (Ctrl+Q)" AutomationProperties.Name="Record">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="RecordIcon" Glyph="&#xE7C8;" FontSize="16"/>
                        <TextBlock Text="Record" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="StopRecord_Click" Padding="10,8"
                        ToolTipService.ToolTip="Stop recording (Ctrl+W)" AutomationProperties.Name="Stop recording">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="StopIcon" Glyph="&#xE71A;" FontSize="16"/>
                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="PlayEvents_Click" Padding="10,8"
                        ToolTipService.ToolTip="Play macro — sends real input (Ctrl+E)" AutomationProperties.Name="Play macro, sends real input">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16"/>
                        <StackPanel x:Name="PlayLabels" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Play" VerticalAlignment="Center"/>
                            <TextBlock Text="Real input" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Click="AbortPlayback_Click" Padding="10,8"
                        ToolTipService.ToolTip="Abort playback (Ctrl+R)" AutomationProperties.Name="Abort playback">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="AbortIcon" Glyph="&#xE711;" FontSize="16"/>
                        <TextBlock Text="Abort" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="OptionsButton" Padding="10,8" ToolTipService.ToolTip="Recording and playback options"
                        AutomationProperties.Name="Recording and playback options">
                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                </Button>
                <Button Content="File" Padding="10,8" AutomationProperties.Name="Macro file commands">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="New macro" Icon="Add" Click="AddTab_Click"/>
                            <MenuFlyoutItem Text="Load macro…" Icon="OpenFile" Click="LoadEvents_Click"/>
                            <MenuFlyoutItem Text="Save macro…" Icon="Save" Click="SaveEvents_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Close application" Click="Close_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <TabView x:Name="MacroTabs" Grid.Row="1" Margin="12,0"
                 CanDragTabs="True" CanReorderTabs="True" CloseButtonOverlayMode="OnPointerOver"
                 IsAddTabButtonVisible="True" TabWidthMode="SizeToContent"
                 AddTabButtonClick="MacroTabs_AddTabButtonClick" SelectionChanged="MacroTabs_SelectionChanged"
                 TabCloseRequested="MacroTabs_TabCloseRequested" TabItemsChanged="MacroTabs_TabItemsChanged"/>
        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="14,8" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Ready"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="ShortcutHint" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Ctrl+Q Record · Ctrl+W Stop · Ctrl+E Play · Ctrl+R Abort"/>
            </Grid>
        </Border>
    </Grid>
</Window>
