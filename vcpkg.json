{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "macro-record",
  "version-string": "0.3.0",
  "builtin-baseline": "f0c8848cde589649bca3ab3649668540403786ce",
  "dependencies": [
    "gtest",
    "protobuf"
  ],
  "features": {
    "portable-ocr": {
      "description": "Prepare the app-local Tesseract CLI (scripts/Prepare-Ocr.ps1)",
      "dependencies": [
        "tesseract",
        { "name": "curl", "default-features": false },
        { "name": "libarchive", "default-features": false },
        { "name": "libwebp", "default-features": false, "features": ["libwebpmux"] },
        { "name": "tiff", "default-features": false }
      ]
    }
  },
  "overrides": [
    {
      "name": "protobuf",
      "version": "3.21.12"
    }
  ]
}
